+#[lua_fn(guard = SessionRead)]
+async fn transcript_anchors(
+    lua: Lua,
+    #[ctx] tx: Option<flume::Sender<UiAction>>,
+) -> LuaResult<Pair<Table>> {
+    let anchors = try_pair!(
+        ui_roundtrip(tx.as_ref(), |reply_tx| UiAction::TranscriptAnchors {
+            reply_tx
+        })
+        .await
+    );
+    let out = lua.create_table_with_capacity(anchors.len(), 0)?;
+    for (index, anchor) in anchors.into_iter().enumerate() {
+        let item = lua.create_table()?;
+        item.set("message_index", anchor.message_index.saturating_add(1))?;
+        item.set("role", anchor.role)?;
+        item.set("preview", anchor.preview)?;
+        item.set("topline", i64::from(anchor.topline) + 1)?;
+        item.set("height", anchor.height)?;
+        out.raw_set(index + 1, item)?;
+    }
+    Ok((Some(out), None))
+}
